    <Object type="System.Windows.Forms.Label, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" name="label1ВыберитеКомпьютерИз" children="Controls">
      <Property name="FlatStyle">Flat</Property>
      <Property name="Font">Microsoft Sans Serif, 11.25pt</Property>
      <Property name="Location">13, 13</Property>
      <Property name="Name">label1ВыберитеКомпьютерИз</Property>
      <Property name="Size">458, 57</Property>
      <Property name="TabIndex">2</Property>
      <Property name="Text" xml:space="preserve">1) Выберите компьютер из списка ( В списке работает поиск).
2)  Нажмите кнопку "ПОДКЛЮЧИТЬСЯ!!"
3) Ожидайте разрешения пользователя на подключение.</Property>
