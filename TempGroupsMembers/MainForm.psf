	$TTL = New-TimeSpan -Days $TimeDay
	$UserLogin = $textbox2.Text
	Add-ADGroupMember -Identity 'Сервис удаленного подключения к сети компании' -Members $UserLogin -MemberTimeToLive $TTL
	
	$formВременныеПраваКУдале.Close()
